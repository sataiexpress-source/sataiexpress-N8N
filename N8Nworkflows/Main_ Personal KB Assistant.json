          "id": "OgF9kem5kTyYQ5da",
          "name": "Ollama account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = ($input.first().json.output || '').toLowerCase();\nconst kbs = ['notes', 'bookmarks', 'references'];\nconst found = kbs.filter(kb => raw.includes(kb));\nconst route_to = found.length > 0 ? found.join(',') : 'notes,bookmarks,references';\nreturn [{ json: { route_to } }];"
      },
      "type": "n8n-nodes-base.code",
