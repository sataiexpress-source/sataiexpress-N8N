    {
      "parameters": {
        "promptType": "define",
        "text": "=USER'S ORIGINAL QUESTION:\n{{ $('When chat message received').item.json.chatInput }}\n\nSPECIALIST ANSWERS TO SYNTHESIZE:\n{{ $json.toJsonString() }}\n\nSynthesize a single answer to the user's question using only the information above.",
        "options": {
          "systemMessage": "You are the Synthesis Agent. You receive (1) the user's original question and (2) answers from one or more specialist agents (Notes, Bookmarks, References) who searched different knowledge bases.\n\nYour job:\n- Combine the relevant specialist answers into a single coherent reply.\n- Use ONLY information present in the specialist outputs. Never invent or use general knowledge.\n- Preserve all source citations (titles, dates, URLs) that specialists provided.\n- If specialists disagree, note both views and attribute each.\n- If all specialists returned \"No relevant X found\", respond: \"I don't have information about this in your knowledge bases.\"\n- Be direct and concise. No \"Based on the specialist outputs...\" preambles."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3,
      "position": [
        1264,
        -160
      ],
      "id": "f447d75c-1a7f-4efe-bf7e-d9ba27c57fdb",
      "name": "Synthesis Agent"
    },
    {
